{
  "name": "@rpg-gen/ui",
  "version": "1.0.0",
  "private": true,
  "description": "Shared Vue 3 UI components for RPG-Gen",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest --run",
    "type-check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "lucide-vue-next": "^0.561.0",
    "marked": "^17.0.0",
    "vue": "^3.5.24"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/ui": "^4.0.8",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^27.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.49.0",
    "vite": "^7.2.7",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.15",
    "vue-tsc": "^3.1.8"
  }
}
