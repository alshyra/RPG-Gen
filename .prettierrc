{
  "singleQuote": true,
  "semi": true,
  "trailingComma": "all",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "arrowParens": "always",
  "singleAttributePerLine": true,
  "bracketSpacing": true,
  "overrides": [
    {
      "files": "*.vue",
      "options": {
        "singleAttributePerLine": true,
        "vueIndentScriptAndStyle": false
      }
    }
  ]
}
