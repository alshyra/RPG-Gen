{
  "rules": {
    "typescript/no-explicit-any": "warn",
    "typescript/no-unused-vars": "warn",
    "unicorn/no-for-loop": "error",
    "unicorn/prefer-array-flat-map": "error",
    "unicorn/prefer-array-some": "error"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2021": true
  },
  "globals": {
    "console": "readonly",
    "process": "readonly",
    "Buffer": "readonly"
  }
}
