{
  "name": "rpg-gen-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "bootstrap": "npm install",
    "start:backend": "npm --workspace @rpg-gen/backend run start:dev",
    "start:frontend": "npm --workspace rpg-gemini-frontend run dev",
    "start:dev": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "test:backend": "npm --workspace @rpg-gen/backend run test",
    "test:frontend": "npm --workspace rpg-gemini-frontend run test",
    "e2e:prepare-db": "node scripts/prepare-e2e-db.mjs",
    "e2e:cleanup-db": "node scripts/prepare-e2e-db.mjs -- --cleanup",
    "test": "npm run test:backend && npm run test:frontend",
    "test:e2e": "npm --workspace @rpg-gen/e2e run test",
    "test:e2e:ui": "npm --workspace @rpg-gen/e2e run test:ui",
    "test:e2e:debug": "npm --workspace @rpg-gen/e2e run test:debug",
    "generate:openapi": "npm --workspace @rpg-gen/backend run generate:openapi",
    "lint": "npm -w @rpg-gen/backend run type-check && npm -w rpg-gemini-frontend run type-check && oxlint .",
    "lint:fix": "npm -w @rpg-gen/backend run type-check && npm -w rpg-gemini-frontend run type-check && oxlint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,vue,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,vue,js,jsx,json,md}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/express": "^5.0.6",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "express": "^5.2.1",
    "oxlint": "^1.32.0",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.49.0"
  },
  "dependencies": {
    "@nestjs/cli": "^11.0.14",
    "@typescript/native-preview": "^7.0.0-dev.20251212.1",
    "jsonc-simple-parser": "^3.0.0",
    "tsconfig-paths": "^4.2.0"
  }
}
